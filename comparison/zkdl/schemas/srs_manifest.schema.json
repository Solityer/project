{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zkDL_gat_srs_manifest",
  "title": "zkDL GATZKG1C family/chunk SRS manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_format", "manifest_version", "curve_id", "encoding", "srs_id", "chunking_rule", "generator_id", "ceremony_transcript_sha256", "ceremony_seed_sha256", "families"],
  "properties": {
    "manifest_format": {"const": "zkgat_srs_manifest"},
    "manifest_version": {"type": "integer", "minimum": 2},
    "curve_id": {"const": "bls12_381"},
    "encoding": {"const": "GATZKG1C"},
    "srs_id": {"type": "string", "minLength": 1},
    "chunking_rule": {"const": "per_family_prefix_v1"},
    "generator_id": {"type": "string", "minLength": 1},
    "ceremony_transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ceremony_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["family_id", "chunks"],
        "properties": {
          "family_id": {"type": "string", "minLength": 1},
          "chunks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["family_id", "chunk_id", "chunk_index", "point_offset", "point_count", "domain", "degree", "point_size", "generator_id", "ceremony_transcript_sha256", "ceremony_seed_sha256", "G", "H", "U"],
              "properties": {
                "family_id": {"type": "string", "minLength": 1},
                "chunk_id": {"type": "string", "minLength": 1},
                "chunk_index": {"type": "integer", "minimum": 0},
                "point_offset": {"type": "integer", "minimum": 0},
                "point_count": {"type": "integer", "minimum": 1},
                "domain": {"type": "integer", "minimum": 1},
                "degree": {"type": "integer", "minimum": 0},
                "point_size": {"const": 48},
                "generator_id": {"type": "string", "minLength": 1},
                "ceremony_transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "ceremony_seed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "G": {"$ref": "#/$defs/frame"}, "H": {"$ref": "#/$defs/frame"}, "U": {"$ref": "#/$defs/frame"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"frame": {"type": "object", "required": ["path", "sha256", "count"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 1}}}}
}
