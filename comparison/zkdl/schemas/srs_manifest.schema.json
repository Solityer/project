{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zkDL_gat_srs_manifest",
  "title": "zkDL GATZKG1C family/chunk SRS manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_format", "manifest_version", "curve_id", "encoding", "srs_id", "chunking_rule", "generator_id", "basis_digest", "generator_digest", "setup", "families"],
  "properties": {
    "manifest_format": {"const": "zkgat_srs_manifest"},
    "manifest_version": {"type": "integer", "minimum": 2},
    "curve_id": {"const": "bls12_381"},
    "encoding": {"const": "GATZKG1C"},
    "srs_id": {"type": "string", "minLength": 1},
    "chunking_rule": {"const": "per_family_prefix_v1"},
    "generator_id": {"type": "string", "minLength": 1},
    "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "setup": {
      "type": "object",
      "required": ["schema", "mode", "trust_status", "algorithm", "spec", "curve_id", "config_binding_digest", "basis_digest", "domain", "generator_count", "h_count", "u_count"],
      "properties": {
        "schema": {"const": "zkDL_gat_local_random_setup_v1"},
        "mode": {"const": "native_local_ephemeral_random"},
        "trust_status": {"const": "native_local_ephemeral_random"},
        "algorithm": {"const": "os_csprng_nonzero_scalar_mul_bls12_381_g1"},
        "spec": {"const": "zkDL_Hyrax_IPA_Pedersen_independent_g1_basis_v1"},
        "curve_id": {"const": "bls12_381"},
        "config_binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "domain": {"type": "integer", "minimum": 1},
        "generator_count": {"type": "integer", "minimum": 1},
        "h_count": {"const": 1},
        "u_count": {"const": 1}
      }
    },
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["family_id", "chunks"],
        "properties": {
          "family_id": {"type": "string", "minLength": 1},
          "chunks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["family_id", "chunk_id", "chunk_index", "point_offset", "point_count", "domain", "required_domain", "degree", "point_size", "generator_id", "basis_digest", "generator_digest", "G", "H", "U"],
              "properties": {
                "family_id": {"type": "string", "minLength": 1},
                "chunk_id": {"type": "string", "minLength": 1},
                "chunk_index": {"type": "integer", "minimum": 0},
                "point_offset": {"type": "integer", "minimum": 0},
                "point_count": {"type": "integer", "minimum": 1},
                "domain": {"type": "integer", "minimum": 1},
                "required_domain": {"type": "integer", "minimum": 1},
                "degree": {"type": "integer", "minimum": 0},
                "point_size": {"const": 48},
                "generator_id": {"type": "string", "minLength": 1},
                "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "generator_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "G": {"$ref": "#/$defs/frame"}, "H": {"$ref": "#/$defs/frame"}, "U": {"$ref": "#/$defs/frame"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {"frame": {"type": "object", "required": ["path", "sha256", "count"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 1}}}}
}
