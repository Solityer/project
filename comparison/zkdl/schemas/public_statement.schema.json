{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zkDL_gat_public_statement_v1",
  "title": "zkDL GAT public statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statement_id", "dataset", "model_arch_id", "model_param_id", "quant_cfg_id", "static_table_id", "input_preprocess_id", "topology_id", "feature_id", "output_id", "public_output_path", "public_output_digest", "relation_registry_digest", "relation_terminal_claims_digest", "relation_mapping_digest", "relation_selector_digest", "relation_degree_digest", "sorted_lookup_descriptor_digest", "sorted_lookup_plan_digest", "sorted_lookup_query_count", "static_table_generator_id", "static_table_version", "static_table_scale_id", "static_table_domain_id", "static_table_row_order", "static_table_spec_hash", "static_table_digest", "static_table_descriptor_digest", "scale_chain_digest", "integer_bound_ledger_id", "integer_bound_ledger_digest", "integer_bound_ledger_descriptor_digest", "config_digest", "asset_manifest_digest", "checkpoint_manifest_digest", "checkpoint_tensors_txt_digest", "checkpoint_tensors_npz_digest", "verifier_registry_digest", "topology_boundary_digest", "total_nodes", "nodes", "edges", "graphs", "classes", "hidden_layer_count", "hidden_head_count", "output_head_count", "proof_scope", "privacy_policy", "verifier_reads_witness"],
  "properties": {
    "schema": {"const": "zkDL_gat_statement_v1"},
    "statement_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset": {"type": "string", "enum": ["cora", "citeseer", "pubmed", "ppi", "ogbn_arxiv"]},
    "model_arch_id": {"type": "string", "minLength": 1},
    "model_param_id": {"type": "string", "minLength": 1},
    "quant_cfg_id": {"type": "string", "minLength": 1},
    "static_table_id": {"type": "string", "minLength": 1},
    "input_preprocess_id": {"type": "string", "minLength": 1},
    "topology_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_output_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))public_Y\\.txt$"},
    "public_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relation_registry_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "relation_terminal_claims_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "relation_mapping_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "relation_selector_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "relation_degree_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "sorted_lookup_descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sorted_lookup_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sorted_lookup_query_count": {"type": "integer", "minimum": 1},
    "static_table_generator_id": {"type": "string", "minLength": 1},
    "static_table_version": {"type": "string", "minLength": 1},
    "static_table_scale_id": {"type": "string", "minLength": 1},
    "static_table_domain_id": {"type": "string", "minLength": 1},
    "static_table_row_order": {"type": "string", "minLength": 1},
    "static_table_spec_hash": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "static_table_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "static_table_descriptor_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "scale_chain_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "integer_bound_ledger_id": {"type": "string", "minLength": 1},
    "integer_bound_ledger_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "integer_bound_ledger_descriptor_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "config_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "asset_manifest_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "checkpoint_manifest_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "checkpoint_tensors_txt_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "checkpoint_tensors_npz_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "verifier_registry_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "topology_boundary_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "total_nodes": {"type": "integer", "minimum": 1},
    "nodes": {"type": "integer", "minimum": 1},
    "edges": {"type": "integer", "minimum": 1},
    "graphs": {"type": "integer", "minimum": 1},
    "classes": {"type": "integer", "minimum": 1},
    "hidden_layer_count": {"type": "integer", "minimum": 1},
    "hidden_head_count": {"type": "integer", "minimum": 1},
    "output_head_count": {"type": "integer", "minimum": 1},
    "proof_scope": {"const": "full_gat_forward"},
    "privacy_policy": {"type": "string", "minLength": 1},
    "verifier_reads_witness": {"const": false}
  }
}
