{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zkDL_gat_result_v1",
  "title": "zkDL GAT production result record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset", "backend", "statement_id", "proof_id", "verification_status", "proof_scope", "static_table_descriptor_digest", "scale_chain_digest", "integer_bound_ledger_id", "integer_bound_ledger_digest", "integer_bound_ledger_descriptor_digest", "proof_size_bytes", "commitment_size_bytes", "commitment_time_seconds", "prove_time_seconds", "verify_time_seconds", "verifier_reads_witness", "gpu_kernel_executed", "silent_fallback", "output_bound", "error"],
  "properties": {
    "schema": {"const": "zkDL_gat_run_record_v1"},
    "dataset": {"type": "string", "enum": ["cora", "citeseer", "pubmed", "ppi", "ogbn_arxiv"]},
    "backend": {"type": "string", "enum": ["cpu", "gpu"]},
    "statement_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proof_id": {"type": "string", "minLength": 1},
    "verification_status": {"type": "string", "enum": ["VERIFIED", "BLOCKED", "NOT_RUN"]},
    "proof_scope": {"const": "full_gat_forward"},
    "static_table_descriptor_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "scale_chain_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "integer_bound_ledger_id": {"type": "string", "minLength": 1},
    "integer_bound_ledger_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "integer_bound_ledger_descriptor_digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|UNAVAILABLE)$"},
    "proof_size_bytes": {"type": "integer", "minimum": 0},
    "commitment_size_bytes": {"type": "integer", "minimum": 0},
    "commitment_time_seconds": {"type": "number", "minimum": 0},
    "prove_time_seconds": {"type": "number", "minimum": 0},
    "verify_time_seconds": {"type": "number", "minimum": 0},
    "verifier_reads_witness": {"const": false},
    "gpu_kernel_executed": {"type": "boolean"},
    "silent_fallback": {"const": false},
    "output_bound": {"type": "boolean"},
    "error": {"type": "string"}
  }
}
