if (CUDA_BACKEND)
  string(TOLOWER "${CUDA_BACKEND}" CUDA_BACKEND_LOWER)
  if (NOT CUDA_BACKEND_LOWER STREQUAL "local")
    message(FATAL_ERROR "formal ezkl permits only a baseline-local CUDA backend")
  endif()
  if (NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/backend/cuda/CMakeLists.txt")
    message(FATAL_ERROR
      "baseline-local ICICLE CUDA backend is missing: ${CMAKE_CURRENT_SOURCE_DIR}/backend/cuda/CMakeLists.txt")
  endif()
  message(STATUS "Adding baseline-local CUDA backend from icicle/backend/cuda")
  add_subdirectory(backend/cuda)
  add_compile_definitions(BACKEND_BUILD_DIR="${CMAKE_BINARY_DIR}/backend")
endif()

if (METAL_BACKEND)
  message(FATAL_ERROR "metal backend is outside the formal ezkl dependency closure")
endif()

if (VULKAN_BACKEND)
  message(FATAL_ERROR "vulkan backend is outside the formal ezkl dependency closure")
endif()
