{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ezkl-gat/formal-cli-contract-v1.schema.json",
  "title": "ezkl native GAT formal CLI contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "contract_id",
    "generated_by",
    "adapter_version",
    "ready",
    "relation_id",
    "proof_scope",
    "public_statement_mode",
    "output_mode",
    "privacy_policy",
    "native_verify_required",
    "gpu_evidence_required",
    "proof_instance_binding",
    "official_chain",
    "prepare_command",
    "producer_command",
    "witness_command",
    "prove_command",
    "verify_command",
    "required_flags",
    "native_backend",
    "gpu_backend"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "baseline": {"const": "ezkl"},
    "contract_id": {"const": "ezkl-gat-native-v1"},
    "generated_by": {"const": "ezkl::gat_adapter"},
    "adapter_version": {"type": "string", "minLength": 1},
    "ready": {"const": true},
    "relation_id": {"const": "R_GAT-ezkl"},
    "proof_scope": {"const": "full_gat"},
    "public_statement_mode": {"const": "external"},
    "output_mode": {"const": "public_logits"},
    "privacy_policy": {"const": "model_and_trace_hidden"},
    "native_verify_required": {"const": true},
    "gpu_evidence_required": {"const": true},
    "proof_instance_binding": {"const": "native_public_instances"},
    "official_chain": {
      "const": ["gat-prepare", "gat-produce", "gat-witness", "prove", "verify"]
    },
    "prepare_command": {"const": "gat-prepare"},
    "producer_command": {"const": "gat-produce"},
    "witness_command": {"const": "gat-witness"},
    "prove_command": {"const": "prove"},
    "verify_command": {"const": "verify"},
    "required_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "producer", "witness", "prove", "verify"],
      "properties": {
        "prepare": {
          "const": ["--dataset", "--phase", "--resource-manifest", "--output-dir", "--srs-path", "--public-statement", "--public-output", "--gpu"]
        },
        "producer": {
          "const": ["--dataset", "--resource-manifest", "--output-dir", "--gpu"]
        },
        "witness": {
          "const": ["--dataset", "--resource-manifest", "--compiled-circuit", "--statement", "--output", "--gpu"]
        },
        "prove": {
          "const": ["--witness", "--compiled-circuit", "--pk-path", "--proof-path", "--srs-path", "--check-mode"]
        },
        "verify": {
          "const": ["--settings-path", "--proof-path", "--vk-path", "--srs-path", "--statement", "--public-output", "--artifact-manifest", "--resource-manifest"]
        }
      }
    },
    "native_backend": {"const": "halo2-kzg-shplonk"},
    "gpu_backend": {"const": "icicle-cuda"}
  }
}
